---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import CallToAction from '../components/CallToAction.astro';
---

<BaseLayout title="About | Clara Blanchard" description="About Clara Blanchard">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="Get to know me"
				tagline="Everything you need to know at a glance."
			>
				<!-- <img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Jeanine White at work with a colleague"
				/> -->

				<div class="cta">
					<CallToAction href="/assets/CV_Clara_Blanchard.pdf" download="CV_Clara_Blanchard.pdf">
						Download my CV
					</CallToAction>
				</div>
			
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I am currently a second-year student pursuing a Master’s degree in Natural Language Processing at the University of Strasbourg in France. 
						My initial exposure to the IT field came during my studies in Translation Technologies at the University of Geneva, which sparked a deep and growing interest in this field.
					</p>
					<p>
						Throughout my academic journey, I have developed solid skills in programming (Python, Java), database management (SQL), data analysis, and machine learning. 
						My major has also provided me with hands-on experience working with large language models (LLMs), an area I am currently exploring in depth through my master’s thesis.
					</p>
					<p>
						I am now looking for my first position as a Data Analyst or Data Scientist, where I can apply my technical skills, keep learning, and contribute effectively to a collaborative team.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Experience</h2>
				<div class="content">
					<p>
						<strong>Data Analyst Intern</strong> — Losinger Marazzi (Bouygues Construction), Switzerland
						March – September 2026
					</p>
					<p>
						Built and deployed production Power BI dashboards from scratch for financial reporting (forecasting, rental billing, internal costs), now used by the CFO, 
						branch managers, and the executive committee. Extracted and modeled data from Snowflake using SQL.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Diploma</h2>
				<div class="content">
					<p>2026 - Master's Degree in Natural Language Processing - University of Strasbourg, France</p>
					<p>2024 - Master's Degree in Translation and Technologies — University of Geneva, Switzerland</p>
					<p>2022 - Bachelor's Degree in Foreign Languages and Business - University of Angers, France</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<div class="skills-lists">
						<ul>
						  <li><strong>Technical Skills</strong></li>
						  <li><strong>Data & Analytics - </strong>Power BI, Snowfalke, SQL, Tableau, Pandas</li>
						  <li><strong>Programming - </strong>Python, Java</li>
						  <li><strong>Machine Learning - </strong>NLTK, spaCy, scikit-learn, TensorFlow</li>
						  <li><strong>Tools - </strong>Streamlit, VSCode, Git, Pycharm</li>
						</ul>
						<ul>
						  <li><strong>Soft Skills</strong></li>
						  <li>Problem-solving</li>
						  <li>Teamwork</li>
						  <li>Adaptability</li>
						  <li>Resilience</li>
						  <li>Communication</li>
						</ul>
					  </div>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
